# ==============================================================================
# 1. Google Gemini AI (Required for AI pseudocode reviews & visualizer)
# ==============================================================================
GEMINI_API_KEY="your_gemini_key_here"
VITE_GEMINI_API_KEY="your_gemini_key_here"

# ==============================================================================
# 2. OpenRouter AI (Optional fallback multi-model provider)
# ==============================================================================
OPENROUTER_API_KEY="your_openrouter_key_here"
VITE_OPENROUTER_API_KEY="your_openrouter_key_here"

# ==============================================================================
# 3. GitHub OAuth Integration (Optional 1-click push to GitHub)
# ==============================================================================
GITHUB_CLIENT_ID="your_github_client_id"
VITE_GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
VITE_GITHUB_CLIENT_SECRET="your_github_client_secret"
ENCRYPTION_KEY="your_32_character_encryption_key"
VITE_ENCRYPTION_KEY="your_32_character_encryption_key"

# ==============================================================================
# 4. Firebase Client Configuration
# ==============================================================================
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_firebase_storage_bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_DATABASE_ID="(default)"

