# ==============================================================================
# 🔒 SERVER SECRETS (Never prefix with VITE_ to prevent client bundle leakage)
# ==============================================================================

# Google Gemini AI (Required for AI pseudocode reviewer & dataset visualizer)
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenRouter AI (Multi-model racing engine fallback)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# GitHub OAuth Integration (OAuth token exchange & LeetCode push)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# AES-256-GCM Token Encryption Key (Must be at least 32 characters in production)
ENCRYPTION_KEY="your_32_character_encryption_key_here"

# ==============================================================================
# 🌐 PUBLIC CLIENT CONFIGURATION (Deliberately exposed to browser bundle)
# ==============================================================================
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_firebase_storage_bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_DATABASE_ID="(default)"

