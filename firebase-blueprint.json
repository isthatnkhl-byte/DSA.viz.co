{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with display metadata, LeetCode stats, and preferences",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 255 },
        "displayName": { "type": "string", "maxLength": 100 },
        "avatarUrl": { "type": "string", "maxLength": 1024 },
        "leetcodeUsername": { "type": "string", "maxLength": 100 },
        "leetcodeStats": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Algorithmic code submission with review verdict, errors, and metrics",
      "type": "object",
      "properties": {
        "problemSlug": { "type": "string", "maxLength": 255 },
        "title": { "type": "string", "maxLength": 255 },
        "code": { "type": "string", "maxLength": 50000 },
        "pseudocode": { "type": "string", "maxLength": 50000 },
        "lang": { "type": "string", "maxLength": 50 },
        "classification": { "type": "string", "maxLength": 50 },
        "difficulty": { "type": "string", "maxLength": 50 },
        "timeComplexity": { "type": "string", "maxLength": 100 },
        "spaceComplexity": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "review": { "type": "string", "maxLength": 10000 },
        "praise": { "type": "string", "maxLength": 5000 },
        "nudge": { "type": "string", "maxLength": 5000 },
        "errorType": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["problemSlug", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Multi-turn Gemini chat conversation history with context",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 255 },
        "problemSlug": { "type": "string", "maxLength": 255 },
        "role": { "type": "string", "maxLength": 50 },
        "messages": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "createdAt"]
    },
    "AiReport": {
      "title": "AiReport",
      "description": "Comprehensive diagnostics report of common syntax and logical mistakes",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 255 },
        "totalSubmissions": { "type": "number" },
        "reportData": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "User activity log for progress tracking",
      "type": "object",
      "properties": {
        "type": { "type": "string", "maxLength": 50 },
        "problemSlug": { "type": "string", "maxLength": 255 },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user profile document"
    },
    "/users/{userId}/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "User algorithmic submissions and evaluation records"
    },
    "/users/{userId}/chat_sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "User multi-turn chat sessions with Gemini"
    },
    "/users/{userId}/ai_reports/{reportId}": {
      "schema": "AiReport",
      "description": "AI-generated diagnostic reports of common mistakes"
    },
    "/users/{userId}/activity/{activityId}": {
      "schema": "ActivityLog",
      "description": "User telemetry and activity events"
    }
  }
}
