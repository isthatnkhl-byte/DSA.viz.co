rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidPayloadSize() {
      return request.resource.data.keys().size() <= 60;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidPayloadSize();
      
      match /submissions/{submissionId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidPayloadSize();
      }
      
      match /chat_sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidPayloadSize();
      }

      match /ai_reports/{reportId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidPayloadSize();
      }

      match /activity/{activityId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidPayloadSize();
      }
      
      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidPayloadSize();
      }

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidPayloadSize();
      }

      // Encrypted user API key vault: only allows tamper-proof AES-256-GCM sealed envelopes
      match /private_vault/{vaultDocId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) &&
                        isValidPayloadSize() &&
                        request.resource.data.sealedEnvelope is string &&
                        request.resource.data.sealedEnvelope.size() <= 16384;
      }
    }

    // Default deny-all rule for any unmatched collections or documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

