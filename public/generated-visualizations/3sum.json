  "code_lines": [
    "def threeSum(nums):",
    "    nums.sort()",
    "    res = []",
    "    for i in range(len(nums)):",
    "        if i > 0 and nums[i] == nums[i-1]: continue",
    "        left, right = i + 1, len(nums) - 1",
    "        while left < right:",
    "            s = nums[i] + nums[left] + nums[right]",
    "            if s == 0:",
    "                res.append([nums[i], nums[left], nums[right]])",
    "                left += 1; right -= 1",
    "            elif s < 0: left += 1",
    "            else: right -= 1",
    "    return res"
  ],
