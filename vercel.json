{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__vpath=/$1"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico|robots.txt).*|$)",
      "destination": "/index.html"
    }
  ]
}
