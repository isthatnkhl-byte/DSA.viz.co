# LiveKit Cloud Project Credentials (free tier: 50GB/month at https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Free Hyper-Fast LLM via Groq Cloud (Free at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key

# Fast STT via Deepgram Nova-3 (Free $200 trial credits at https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Kokoro Voice Choice (e.g. 'af_bella', 'af_sarah', 'am_adam', 'am_michael')
KOKORO_VOICE=af_bella
